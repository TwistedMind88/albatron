      "icons/128x128.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RTM5M0Q1NEZFM0VFOEEKUldTSzd1TlAxWlBqdHo3NHY5NWtPVFU2Unl5azlENUlMSTJnT1JiQ2pBMHgxc2JBcTcySHNadlgK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
