{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Albatron",
  "version": "1.1.1",
  "identifier": "rs.albatron.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Albatron",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
