{
  "name": "albatron",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter @albatron/server dev",
    "dev:web": "pnpm --filter @albatron/web dev",
    "build": "pnpm -r build",
    "lint": "eslint apps/server/src apps/web/src packages/shared/src",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "version": "1.1.0"
}
